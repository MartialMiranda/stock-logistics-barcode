<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_barcodes_read_picking_batch_form" model="ir.ui.view">
        <field name="name">stock.barcodes.read.picking.batch.form</field>
        <field name="model">wiz.stock.barcodes.read.picking</field>
        <field name="inherit_id" ref="stock_barcodes.view_stock_barcodes_read_form" />
        <field name="mode">primary</field>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='message_type']" position="before">
                <field name="candidate_picking_batch_ids" mode="kanban" invisible="candidate_picking_batch_ids == []" nolabel="1" options='{"always_reload": True}' force_save="1">
                    <kanban>
                        <field name="name" />
                        <field name="date" />
                        <field name="state" />
                        <field name="picking_batch_id" />
                        <field name="wiz_picking_batch_id" />
                        <field name="scan_count" />
                        <field name="is_pending" />
                        <field name="product_ref_count" />
                        <field name="product_ref_done" />
                        <templates>
                            <t t-name="kanban-box">
                                <div t-att-class="'oe_kanban_color_alert' + (record.is_pending and record.is_pending.raw_value == false ? ' bg-success text-white' : '')">
                                    <div invisible="1">
                                        <a
                                            name="action_lock_picking"
                                            type="object"
                                            t-if="record.picking_batch_id and record.wiz_picking_batch_id and record.picking_batch_id.raw_value and record.picking_batch_id.raw_value != record.wiz_picking_batch_id.raw_value"
                                            class="fa fa-thumb-tack fa-2x pull-right"
                                            context="{'wiz_barcode_id': parent.id, 'picking_batch_id': picking_batch_id}"
                                        />
                                        <a
                                            name="action_unlock_picking"
                                            type="object"
                                            class="pull-right"
                                            t-if="record.picking_batch_id and record.wiz_picking_batch_id and record.picking_batch_id.raw_value and record.picking_batch_id.raw_value == record.wiz_picking_batch_id.raw_value"
                                            context="{'wiz_barcode_id': parent.id}"
                                        >
                                            <span class="fa-stack fa-lg">
                                                <i class="fa fa-thumb-tack fa-stack-1x" />
                                                <i class="fa fa-ban fa-stack-2x" />
                                            </span>
                                        </a>
                                    </div>
                                    <div></div>
                                    <div class="oe_kanban_details">
                                        <div class="row">
                                            <div class="col">
                                                <strong>
                                                    <field name="name" />
                                                    <field name="scan_count" invisible="1" force_save="1" />
                                                </strong>
                                            </div>
                                            <div class="col">
                                                <div class="float-end">
                                                    <span for="product_ref_count">#Ref: </span>
                                                    <strong>
                                                        <t t-if="record.product_ref_count and record.product_ref_count.raw_value is not None">
                                                            <field name="product_ref_count" />
                                                        </t>
                                                    </strong>
                                                    <span> | </span>
                                                    <span for="product_ref_done">#Read: </span>
                                                    <strong>
                                                        <t t-if="record.product_ref_done and record.product_ref_done.raw_value is not None">
                                                            <field name="product_ref_done" />
                                                        </t>
                                                    </strong>
                                                </div>
                                            </div>
                                        </div>
                                        <div>
                                            <button
                                                name="action_open_picking_batch"
                                                type="object"
                                                class="btn btn-secondary float-start border"
                                                context="{'wiz_barcode_id': parent.id, 'picking_batch_id': picking_batch_id}"
                                            >Open</button>
                                            <button
                                                name="action_validate_picking_batch"
                                                type="object"
                                                t-att-class="'btn float-end' + (record.is_pending and record.is_pending.raw_value == false ? ' btn-primary' : ' btn-secondary border')"
                                                invisible="state != 'in_progress'"
                                                confirm="Are you sure to validate the picking batch?"
                                                context="{'wiz_barcode_id': parent.id, 'picking_batch_id': picking_batch_id}"
                                            >Validate</button>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </templates>
                    </kanban>
                </field>
                <field name="todo_line_display_ids" mode="kanban" force_save="1" />
            </xpath>
            <field name="location_id" position="before">
                <field name="picking_type_code" invisible="1" force_save="1" />
                <field name="picking_batch_id" invisible="1" force_save="1" />
                <field name="show_detailed_operations" invisible="1" />
            </field>
            <group name="scan_fields" position="after">
                <group string="Pending moves" invisible="pending_move_ids == []">
                    <field name="pending_move_ids" options="{'no_open': True, 'always_reload': True}" nolabel="1" colspan="2" force_save="1" mode="tree,kanban">
                        <tree>
                            <field name="state" invisible="1" />
                            <field name="product_id" />
                            <field name="product_uom_qty" />
                            <field name="line_ids" invisible="1" />
                            <field name="lot_id" groups="stock.group_production_lot" optional="hide" />
                            <field name="package_id" groups="stock.group_tracking_lot" optional="hide" />
                            <field name="qty_done" />
                            <button name="fill_from_pending_line" type="object" class="btn" icon="fa-upload" context="{'wiz_barcode_id': parent.id}" />
                        </tree>
                        <kanban class="o_kanban_mobile">
                            <field name="state" />
                            <field name="product_id" />
                            <field name="product_uom_qty" />
                            <field name="qty_done" />
                            <templates>
                                <t t-name="kanban-box">
                                    <div t-attf-class="oe_kanban_card">
                                        <div class="row">
                                            <div class="col-6">
                                                <strong>
                                                    <t t-if="record.product_id and record.product_id.raw_value">
                                                        <field name="product_id" />
                                                    </t>
                                                </strong>
                                            </div>
                                            <div class="col-2">
                                                <span class="pull-right text-right text-muted">
                                                    <t t-if="record.product_uom_qty and record.product_uom_qty.raw_value is not None">
                                                        <field name="product_uom_qty" />
                                                    </t>
                                                </span>
                                            </div>
                                            <div class="col-2">
                                                <span class="pull-right text-right" t-att-class="qty_done >= product_uom_qty ? 'text-success' : ''">
                                                    <t t-if="record.qty_done and record.qty_done.raw_value is not None">
                                                        <field name="qty_done" />
                                                    </t>
                                                </span>
                                            </div>
                                            <div class="col-2 text-right">
                                                <button name="fill_from_pending_line" type="object" class="btn" context="{'wiz_barcode_id': parent.id}">
                                                    <i class="fa fa-upload" title="Fill from pencil" style="font-size:1.5em" />
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </group>
                <group string="Detailed operations" invisible="move_line_ids == [] or show_detailed_operations == False">
                    <field name="move_line_ids" options="{'no_open': True, 'always_reload': True}" nolabel="1" force_save="1" colspan="2" mode="tree,kanban">
                        <tree>
                            <field name="picking_code" invisible="1" />
                            <field name="product_id" options="{'no_open': True}" />
                            <field name="location_id" options="{'no_open': True}" groups="stock.group_stock_multi_locations" invisible="picking_code == 'incoming'" optional="show" />
                            <field name="location_dest_id" options="{'no_open': True}" groups="stock.group_stock_multi_locations" invisible="picking_code == 'outgoing'" optional="show" />
                            <field name="lot_id" groups="stock.group_production_lot" options="{'no_open': True}" optional="show" />
                            <field name="result_package_id" groups="stock.group_tracking_lot" options="{'no_open': True}" optional="show" />
                            <field name="quantity" />
                            <field name="product_uom_id" groups="uom.group_uom" options="{'no_open': True}" />
                            <button name="action_barcode_detailed_operation_unlink" type="object" class="btn" icon="fa-trash" context="{'wiz_barcode_id': parent.id}" />
                        </tree>
                        <kanban class="o_kanban_mobile">
                            <field name="product_id" />
                            <field name="quantity" />
                            <field name="product_uom_id" />
                            <templates>
                                <t t-name="kanban-box">
                                    <div t-attf-class="oe_kanban_card">
                                        <div class="row">
                                            <div class="col-7">
                                                <strong>
                                                    <t t-if="record.product_id and record.product_id.raw_value">
                                                        <field name="product_id" />
                                                    </t>
                                                </strong>
                                            </div>
                                            <div class="col-2">
                                                <span class="pull-right text-right font-weight-bold">
                                                    <t t-if="record.quantity and record.quantity.raw_value is not None">
                                                        <field name="quantity" />
                                                    </t>
                                                </span>
                                            </div>
                                            <div class="col-3 text-right">
                                                <button name="action_barcode_detailed_operation_unlink" type="object" class="btn mt0" context="{'wiz_barcode_id': parent.id}">
                                                    <i class="fa fa-trash" title="Remove" style="font-size:1.5em" />
                                                </button>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4">
                                                <t t-if="record.lot_id and record.lot_id.raw_value">
                                                    Lot: <field name="lot_id" />
                                                </t>
                                            </div>
                                            <t t-if="record.result_package_id and record.result_package_id.raw_value">
                                                <div class="col-4">
                                                    Package: <field name="result_package_id" />
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </group>
            </group>
        </field>
    </record>
    <!--
     Open wizard in current target option to avoid that the wizard is
     closed after any button click,
    -->
    <record model="ir.actions.act_window" id="action_stock_barcodes_read_picking_batch">
        <field name="res_model">wiz.stock.barcodes.read.picking</field>
        <field name="name">Barcodes Read</field>
        <field name="view_mode">form</field>
        <field name="context">{"control_panel_hidden": True,
                               "form_view_initial_mode": "edit"}
        </field>
        <field name="view_id" ref="view_stock_barcodes_read_picking_batch_form" />
        <field name="target">current</field>
    </record>
</odoo>
